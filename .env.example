# Cloud Security Alert Lamp - Environment Configuration
# Copy this file to .env and adjust variables as required.

# AWS Region & Environment
AWS_DEFAULT_REGION=ap-south-1
AWS_REGION=ap-south-1

# Set to 'true' to run in zero-cost offline college demo mode
# Set to 'false' to connect to live AWS services
MOCK_MODE=true

# AWS Services Configuration (Required when MOCK_MODE=false)
# If running on EC2 or Lambda with IAM roles, leave Access Keys empty.
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

DYNAMODB_TABLE_NAME=SecurityEvents
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:S3SecurityAlerts
LAMBDA_FUNCTION_NAME=S3SecurityAuditor
AWS_IOT_ENDPOINT=a1b2c3d4e5f6-ats.iot.ap-south-1.amazonaws.com
AWS_IOT_TOPIC=security/alert/led

# Server Port
PORT=8000
HOST=0.0.0.0
